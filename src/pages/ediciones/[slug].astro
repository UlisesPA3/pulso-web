---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import { ArrowLeft } from 'lucide-react';
import VisorPDF from '../../components/React/VisorPDF';
import Layout from '../../layouts/Layout.astro';
import { getEdicionesPublicadas, type Edicion } from '../../lib/ediciones';
import { portableTextAHtml } from '../../lib/portable-text';

export const getStaticPaths = (async () => {
  const ediciones = await getEdicionesPublicadas();
  return ediciones.map((edicion) => ({
    params: { slug: edicion.slug },
    props: { edicion },
  }));
}) satisfies GetStaticPaths;

interface Props {
  edicion: Edicion;
}

const { edicion } = Astro.props;
const { titulo, volumen, numero, fecha, resumen, archivoPdf, pdfDescarga, carta } = edicion;
// Carta editorial: Portable Text si viene de Sanity, el cuerpo del Markdown si viene del respaldo local.
const cartaHtml = carta.origen === 'sanity' ? portableTextAHtml(carta.bloques) : undefined;
const Content = carta.origen === 'local' ? (await render(carta.entrada)).Content : undefined;
const hayCarta = Boolean(Content) || Boolean(cartaHtml?.trim());
---

<Layout title={titulo} description={resumen}>
  <a href="/ediciones" class="link-arrow group text-sm">
    <ArrowLeft className="h-4 w-4 transition-transform duration-200 group-hover:-translate-x-1" aria-hidden="true" /> Hemeroteca
  </a>

  <header class="mt-4 max-w-3xl">
    <p class="eyebrow rise" style="--i:0">
      Vol. {volumen} · Núm. {numero} · <time>{fecha}</time>
    </p>
    <h1 class="text-display rise mt-4 text-4xl text-balance sm:text-6xl" style="--i:1">{titulo}</h1>
    <p class="rise mt-5 text-lg text-primary-100" style="--i:2">{resumen}</p>
  </header>

  <section class="mt-10" aria-labelledby="visor-titulo">
    <h2 id="visor-titulo" class="sr-only">Leer la edición</h2>
    {
      // Una edición puede publicarse antes de subir su PDF: en ese caso no se monta el visor.
      archivoPdf ? (
        <>
          {/* client:only: PDF.js depende de APIs del navegador y no puede ejecutarse en el servidor. */}
          <VisorPDF client:only="react" url={archivoPdf} urlDescarga={pdfDescarga} titulo={titulo}>
            <div
              slot="fallback"
              class="mx-auto flex aspect-[3/4] w-full max-w-2xl animate-pulse items-center justify-center rounded-lg border border-white/10 bg-white/[0.06] text-sm text-primary-100 sm:aspect-[3/2]"
            >
              Cargando el visor…
            </div>
          </VisorPDF>
          <noscript>
            <p class="mt-4 text-center text-primary-100">
              El visor necesita JavaScript. <a class="text-accent-green underline" href={archivoPdf}>Abre el PDF directamente</a>.
            </p>
          </noscript>
        </>
      ) : (
        <div class="surface px-6 py-12 text-center">
          <p class="text-title text-xl">El PDF de esta edición aún no está disponible</p>
          <p class="mt-2 text-primary-100">Lo publicaremos aquí en cuanto esté listo. Mientras tanto, puedes leer los números anteriores.</p>
          <a href="/ediciones" class="btn btn-outline mt-6">Ir a la hemeroteca</a>
        </div>
      )
    }
  </section>

  {
    hayCarta && (
      <section class="mt-14 max-w-3xl border-t border-white/10 pt-10" aria-labelledby="carta-editorial">
        <h2 id="carta-editorial" class="text-title text-2xl">Carta editorial</h2>
        <div class="mt-4 space-y-4 leading-relaxed text-primary-100">
          {Content ? <Content /> : <Fragment set:html={cartaHtml} />}
        </div>
      </section>
    )
  }
</Layout>

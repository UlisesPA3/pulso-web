---
import { ArrowRight, BookOpen, Clock, Library } from 'lucide-react';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import BannerLema from '../components/BannerLema.astro';
import EdicionCard from '../components/EdicionCard.astro';
import SobreNosotros from '../components/SobreNosotros.astro';
import Conecta from '../components/Conecta.astro';
import Equipo from '../components/Equipo.astro';
import ContactoBloque from '../components/ContactoBloque.astro';
import { getEdicionActual, getEdicionesPublicadas, tienePortada } from '../lib/ediciones';
import { ACENTOS, secciones } from '../lib/secciones';
import { ICONOS_SECCION } from '../lib/secciones-iconos';
import { destacados } from '../lib/destacados';

const ediciones = await getEdicionesPublicadas();
// La edición actual es la más reciente que ya se puede leer: hoy, Vol. 1 · Núm. 3.
const actual = await getEdicionActual();
const actualHref = actual ? `/ediciones/${actual.id}` : '/ediciones';

const seccionPorSlug = Object.fromEntries(secciones.map((s) => [s.slug, s]));
const edicionPorSlug = Object.fromEntries(ediciones.map((e) => [e.id, e]));
const pasadas = destacados.map((d) => ({
  ...d,
  seccion: seccionPorSlug[d.seccion],
  Icono: ICONOS_SECCION[d.seccion],
  numero: edicionPorSlug[d.edicion]?.data.numero,
}));

// La hemeroteca del inicio muestra hasta 4 ejemplares; si sobra un hueco, lo ocupa "Próximamente".
const enEstante = ediciones.slice(0, 4);
const huecoProximamente = enEstante.length < 4;
---

<Layout bleed>
  <Hero />
  <BannerLema />

  {/* ---------- Edición actual ---------- */}
  {
    actual && (
      <section id="revista" class="container-pulso scroll-mt-20 py-20 sm:py-28" aria-labelledby="actual-titulo">
        <div class="grid items-center gap-10 md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] md:gap-16" data-reveal="children">
          <a href={actualHref} class="group relative mx-auto block w-full max-w-xs [perspective:1200px] md:max-w-none" tabindex="-1" aria-hidden="true">
            <span class="absolute -inset-6 -z-10 rounded-full bg-primary-300/50 blur-3xl"></span>
            {tienePortada(actual) ? (
              <img
                src={actual.data.portada}
                alt=""
                width="720"
                height="863"
                class="w-full rounded-r-lg rounded-l-sm shadow-lift ring-1 ring-ink/10 transition-transform duration-700 ease-out-expo [transform:rotateY(-14deg)_rotateX(3deg)] group-hover:[transform:rotateY(-4deg)_rotateX(0deg)]"
              />
            ) : (
              <div class="flex aspect-[5/6] items-end rounded-lg bg-linear-to-br from-primary to-bg-dark p-8 shadow-lift ring-1 ring-ink/10">
                <p class="text-title text-2xl text-accent-lime">{actual.data.titulo}</p>
              </div>
            )}
          </a>

          <div>
            <p class="flex flex-wrap items-center gap-x-3 gap-y-2">
              <span class="rounded-full bg-primary px-3 py-1 font-mono text-xs font-medium tracking-[0.18em] text-white uppercase">Edición actual</span>
              <span class="font-mono text-xs font-medium tracking-[0.18em] text-primary uppercase">
                Vol. {actual.data.volumen} · Núm. {actual.data.numero}
              </span>
              <span class="font-mono text-xs tracking-[0.18em] text-ink/60 uppercase"><time>{actual.data.fecha}</time></span>
            </p>
            <h2 id="actual-titulo" class="text-display mt-5 text-4xl text-balance sm:text-6xl">{actual.data.titulo}</h2>
            <p class="mt-5 max-w-lg text-lg leading-relaxed text-ink/75">{actual.data.resumen}</p>
            <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:gap-4">
              <a href={actualHref} class="btn btn-primary">
                <BookOpen className="h-5 w-5" aria-hidden="true" />
                Leer revista
              </a>
              <a href="/ediciones" class="btn btn-outline">
                <Library className="h-5 w-5" aria-hidden="true" />
                Explorar hemeroteca
              </a>
            </div>
          </div>
        </div>
      </section>
    )
  }

  {/* ---------- También en ediciones pasadas (un artículo por sección) ---------- */}
  <section class="border-y border-primary-100 bg-white py-16 sm:py-24" aria-labelledby="pasadas-titulo">
    <div class="container-pulso">
      <div class="flex flex-wrap items-end justify-between gap-4" data-reveal>
        <h2 id="pasadas-titulo" class="font-display text-2xl font-extrabold tracking-[0.06em] text-primary uppercase sm:text-3xl">
          También en ediciones pasadas
        </h2>
        <a href="/ediciones" class="link-arrow group">
          Ver todas las ediciones
          <ArrowRight className="h-5 w-5 transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true" />
        </a>
      </div>

      <ul class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-reveal="children">
        {
          pasadas.map(({ seccion, Icono, edicion, numero, titulo, resumen, imagen }) => {
            const a = ACENTOS[seccion.acento];
            return (
              <li>
                <a
                  href={`/ediciones/${edicion}`}
                  class="group flex h-full flex-col overflow-hidden rounded-2xl border border-ink/10 bg-white shadow-[0_1px_2px_rgb(38_28_42/0.06),0_10px_24px_-18px_rgb(38_28_42/0.35)] transition-[transform,box-shadow,border-color] duration-300 ease-out-expo hover:-translate-y-1 hover:border-primary-300 hover:shadow-shelf"
                >
                  {/* Cabecera: foto del artículo o, mientras no exista, degradado con el ícono de la sección */}
                  <div class={`relative aspect-[16/10] overflow-hidden bg-linear-to-br ${a.cabecera}`}>
                    {imagen ? (
                      <img src={imagen} alt="" loading="lazy" decoding="async" class="h-full w-full object-cover transition-transform duration-500 ease-out-expo group-hover:scale-105" />
                    ) : (
                      <>
                        <span class="absolute inset-0 bg-[radial-gradient(circle_at_1px_1px,rgb(38_28_42/0.09)_1px,transparent_0)] bg-[size:18px_18px]" aria-hidden="true" />
                        <Icono className={`absolute top-1/2 left-1/2 h-16 w-16 -translate-x-1/2 -translate-y-1/2 stroke-[1.25] transition-transform duration-500 ease-out-expo group-hover:scale-110 ${a.icono}`} aria-hidden="true" />
                      </>
                    )}
                    {numero && (
                      <span class="absolute top-3 right-3 rounded-full bg-white/90 px-2.5 py-1 font-mono text-xs font-medium tracking-wider text-ink/70 uppercase backdrop-blur-sm">
                        Núm. {numero}
                      </span>
                    )}
                  </div>
                  <div class="flex flex-1 flex-col p-6">
                    <p class={`text-xs font-bold tracking-[0.14em] uppercase ${a.etiqueta}`}>{seccion.nombre}</p>
                    <h3 class="mt-2 font-display text-xl leading-snug font-bold text-ink transition-colors group-hover:text-primary">{titulo}</h3>
                    <p class="mt-2 line-clamp-3 text-[0.95rem] leading-relaxed text-ink/60">{resumen}</p>
                  </div>
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>

  {/* ---------- Dentro de PULSO: las 9 secciones oficiales ---------- */}
  <section id="secciones" class="container-pulso scroll-mt-20 py-16 sm:py-24" aria-labelledby="secciones-titulo">
    <div class="max-w-3xl" data-reveal>
      <p class="font-display text-sm font-extrabold tracking-[0.2em] text-accent-green-dark uppercase">Dentro de PULSO</p>
      <h2 id="secciones-titulo" class="text-display mt-4 text-4xl text-balance sm:text-5xl">
        Distintas formas de explorar la Ingeniería Biomédica.
      </h2>
      <p class="mt-5 text-lg leading-relaxed text-ink/70">
        Cada sección tiene una intención diferente: descubrir, entender, conectar y encontrar nuevas posibilidades.
      </p>
    </div>

    <ul class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3" data-reveal="children">
      {
        secciones.map((seccion) => {
          const a = ACENTOS[seccion.acento];
          const Icono = ICONOS_SECCION[seccion.slug];
          return (
            <li class="relative overflow-hidden rounded-2xl border border-ink/10 bg-white p-6 pt-7 transition-[transform,box-shadow] duration-300 ease-out-expo hover:-translate-y-1 hover:shadow-shelf sm:p-7 sm:pt-8">
              <span class={`absolute inset-x-0 top-0 h-1 ${a.linea}`} aria-hidden="true" />
              <div class="flex items-start justify-between">
                <span class={`flex h-12 w-12 items-center justify-center rounded-full ${a.pastel} ${a.icono}`}>
                  <Icono className="h-6 w-6" aria-hidden="true" />
                </span>
                <span class="font-display text-5xl leading-none font-bold text-gray-200/80 select-none" aria-hidden="true">{seccion.numero}</span>
              </div>
              <h3 class="mt-6 font-display text-xl font-bold tracking-wide text-ink">{seccion.nombre}</h3>
              <p class="mt-2 leading-relaxed text-ink/70">{seccion.descripcion}</p>
            </li>
          );
        })
      }
    </ul>
  </section>

  {/* ---------- Hemeroteca PULSO ---------- */}
  <section class="container-pulso py-16 sm:py-24" aria-labelledby="hemeroteca-titulo">
    <div class="flex flex-wrap items-end justify-between gap-4" data-reveal>
      <div>
        <p class="eyebrow">Todas las ediciones</p>
        <h2 id="hemeroteca-titulo" class="text-display mt-4 text-4xl sm:text-6xl">Hemeroteca PULSO</h2>
      </div>
      <a href="/ediciones" class="link-arrow group">
        Ver la hemeroteca completa
        <ArrowRight className="h-5 w-5 transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true" />
      </a>
    </div>
    <ul class="mt-12 grid grid-cols-2 gap-x-6 gap-y-12 sm:gap-x-10 md:grid-cols-3 lg:grid-cols-4" data-reveal="children">
      {enEstante.map((edicion) => <li><EdicionCard edicion={edicion} nivel="h3" /></li>)}
      {
        huecoProximamente && (
          <li class="pb-5 md:max-lg:hidden">
            <div class="flex aspect-[5/6] flex-col items-center justify-center gap-3 rounded-md border-2 border-dashed border-primary-300 bg-white/60 p-4 text-center">
              <Clock className="h-8 w-8 text-primary-400" aria-hidden="true" />
              <p class="font-display text-lg font-bold text-primary">Próximamente</p>
              <p class="text-sm text-ink/60">El siguiente número ya está en preparación.</p>
            </div>
          </li>
        )
      }
    </ul>
  </section>

  <SobreNosotros />
  <Conecta />
  <Equipo />

  {/* ---------- Contacto ---------- */}
  <section id="contacto" class="container-pulso scroll-mt-20 py-16 sm:py-24" aria-labelledby="contacto-titulo">
    <div class="max-w-3xl" data-reveal>
      <p class="eyebrow font-display text-sm font-extrabold tracking-[0.2em]">Contacto</p>
      <h2 id="contacto-titulo" class="text-display mt-4 text-4xl text-balance sm:text-5xl">Tu voz impulsa el próximo pulso</h2>
      <p class="mt-5 text-lg leading-relaxed text-ink/75">
        ¿Quieres proponer un tema, colaborar con un artículo o sumarte al equipo? Escríbenos por cualquiera de estos canales.
      </p>
    </div>
    <div class="mt-10" data-reveal>
      <ContactoBloque />
    </div>
  </section>
</Layout>

---
import { ArrowRight, BookOpen, Clock, Library } from 'lucide-react';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import BannerLema from '../components/BannerLema.astro';
import EdicionCard from '../components/EdicionCard.astro';
import CarruselEdiciones, { type TarjetaPasada } from '../components/React/CarruselEdiciones';
import SobreNosotros from '../components/SobreNosotros.astro';
import Conecta from '../components/Conecta.astro';
import Equipo from '../components/Equipo.astro';
import ContactoBloque from '../components/ContactoBloque.astro';
import { getEdicionActual, getEdicionesPublicadas, tienePortada } from '../lib/ediciones';
import { ACENTOS, BENTO, secciones, type SlugSeccion, type TamanoBento } from '../lib/secciones';
import { ICONOS_SECCION } from '../lib/secciones-iconos';
import { getDestacados } from '../lib/destacados';

const ediciones = await getEdicionesPublicadas();
// La edición actual es la más reciente que ya se puede leer: hoy, Vol. 1 · Núm. 3.
const actual = await getEdicionActual();
const actualHref = actual ? `/ediciones/${actual.slug}` : '/ediciones';
const destacados = await getDestacados();

const seccionPorSlug = Object.fromEntries(secciones.map((s) => [s.slug, s]));
const edicionPorSlug = new Map(ediciones.map((e) => [e.slug, e]));
// Datos planos (serializables) para la isla del carrusel: el ícono lo resuelve ella por slug.
// Se omiten las tarjetas cuya edición no existe en este build (llevarían a un 404).
const pasadas: TarjetaPasada[] = destacados.filter((d) => edicionPorSlug.has(d.edicionSlug)).map((d) => {
  const seccion = seccionPorSlug[d.seccion];
  const { cabecera, icono, etiqueta } = ACENTOS[seccion.acento];
  return {
    slug: d.seccion,
    seccion: seccion.nombre,
    href: `/ediciones/${d.edicionSlug}`,
    titulo: d.titulo,
    resumen: d.resumen,
    numero: d.edicionNumero ?? edicionPorSlug.get(d.edicionSlug)?.numero,
    imagen: d.imagen,
    cabecera,
    icono,
    etiqueta,
  };
});

// Bento de "Dentro de PULSO": clases por tamaño de celda. La tipografía y la distribución
// interna crecen con la celda; en móvil todas se ven como la tarjeta normal.
const normal = {
  celda: 'p-6 pt-7',
  halo: false,
  marca: false,
  insignia: 'h-12 w-12',
  icono: 'h-6 w-6',
  numero: 'text-5xl',
  cuerpo: 'mt-6',
  titulo: 'text-xl',
  texto: 'mt-2 leading-relaxed lg:text-[0.95rem]',
};
const TAMANOS: Record<TamanoBento, typeof normal> = {
  normal,
  // Solo cambia la celda en tablet; por dentro es una tarjeta normal.
  anchaTablet: { ...normal, celda: `${normal.celda} md:max-lg:col-span-2` },
  // 2x1 en escritorio: un escalón más de tipografía y resplandor de acento.
  ancha: {
    ...normal,
    celda: 'p-6 pt-7 lg:col-span-2 lg:p-8 lg:pt-9',
    halo: true,
    insignia: 'h-12 w-12 lg:h-14 lg:w-14',
    icono: 'h-6 w-6 lg:h-7 lg:w-7',
    numero: 'text-5xl lg:text-6xl',
    titulo: 'text-xl lg:text-2xl',
    texto: 'mt-2 leading-relaxed lg:max-w-md lg:text-lg',
  },
  // 2x2 en escritorio (2x1 en tablet): cabecera arriba, texto anclado abajo, ícono como
  // marca de agua en el hueco central y tipografía de titular.
  grande: {
    celda: 'p-6 pt-7 md:col-span-2 md:p-8 md:pt-9 lg:row-span-2 lg:p-10 lg:pt-11',
    halo: true,
    marca: true,
    insignia: 'h-12 w-12 md:h-14 md:w-14 lg:h-16 lg:w-16',
    icono: 'h-6 w-6 md:h-7 md:w-7 lg:h-8 lg:w-8',
    numero: 'text-5xl md:text-7xl lg:text-8xl',
    cuerpo: 'mt-6 lg:mt-auto lg:pt-10',
    titulo: 'text-xl md:text-2xl lg:text-4xl lg:leading-[1.05]',
    texto: 'mt-2 leading-relaxed md:max-w-xl md:text-lg lg:mt-4 lg:max-w-md lg:text-xl lg:leading-relaxed',
  },
};
const bento = Object.fromEntries(secciones.map((s) => [s.slug, TAMANOS[BENTO[s.slug] ?? 'normal']])) as Record<SlugSeccion, typeof normal>;

// La hemeroteca del inicio muestra hasta 4 ejemplares; si sobra un hueco, lo ocupa "Próximamente".
const enEstante = ediciones.slice(0, 4);
const huecoProximamente = enEstante.length < 4;
---

<Layout bleed>
  <Hero />
  <BannerLema />

  {/* ---------- Edición actual ---------- */}
  {
    actual && (
      <section id="revista" class="container-pulso scroll-mt-20 py-20 sm:py-28" aria-labelledby="actual-titulo">
        <div class="grid items-center gap-10 md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] md:gap-16" data-reveal="children">
          <a href={actualHref} class="group relative mx-auto block w-full max-w-xs [perspective:1200px] md:max-w-none" tabindex="-1" aria-hidden="true">
            <span class="absolute -inset-6 -z-10 rounded-full bg-primary-500/45 blur-3xl"></span>
            {tienePortada(actual) ? (
              <img
                src={actual.portada}
                alt=""
                width="720"
                height="863"
                class="w-full rounded-r-lg rounded-l-sm shadow-lift ring-1 ring-white/10 transition-transform duration-700 ease-out-expo [transform:rotateY(-14deg)_rotateX(3deg)] group-hover:[transform:rotateY(-4deg)_rotateX(0deg)]"
              />
            ) : (
              <div class="flex aspect-[5/6] items-end rounded-lg bg-linear-to-br from-primary to-bg-dark p-8 shadow-lift ring-1 ring-white/10">
                <p class="text-title text-2xl text-accent-lime">{actual.titulo}</p>
              </div>
            )}
          </a>

          <div>
            <p class="flex flex-wrap items-center gap-x-3 gap-y-2">
              <span class="rounded-full bg-accent-green px-3 py-1 font-mono text-xs font-medium tracking-[0.18em] text-ink uppercase">Edición actual</span>
              <span class="font-mono text-xs font-medium tracking-[0.18em] text-primary-300 uppercase">
                Vol. {actual.volumen} · Núm. {actual.numero}
              </span>
              <span class="font-mono text-xs tracking-[0.18em] text-primary-200 uppercase"><time>{actual.fecha}</time></span>
            </p>
            <h2 id="actual-titulo" class="text-display mt-5 text-4xl text-balance sm:text-6xl">{actual.titulo}</h2>
            <p class="mt-5 max-w-lg text-lg leading-relaxed text-primary-100">{actual.resumen}</p>
            <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:gap-4">
              <a href={actualHref} class="btn btn-primary">
                <BookOpen className="h-5 w-5" aria-hidden="true" />
                Leer revista
              </a>
              <a href="/ediciones" class="btn btn-outline">
                <Library className="h-5 w-5" aria-hidden="true" />
                Explorar hemeroteca
              </a>
            </div>
          </div>
        </div>
      </section>
    )
  }

  {/* ---------- También en ediciones pasadas (un artículo por sección) ---------- */}
  {
    pasadas.length > 0 && (
      <section class="band py-16 sm:py-24" aria-labelledby="pasadas-titulo">
        {/* Isla React (SPEC-06C): carrusel de 4 tarjetas que "Ver todas" despliega en cuadrícula.
            El revelado va en este div y no dentro de la isla, para no tocar el DOM que React hidrata. */}
        <div class="container-pulso" data-reveal>
          <CarruselEdiciones client:visible titulo="También en ediciones pasadas" tarjetas={pasadas} />
        </div>
      </section>
    )
  }

  {/* ---------- Dentro de PULSO: las 9 secciones oficiales ---------- */}
  <section id="secciones" class="container-pulso scroll-mt-20 py-16 sm:py-24" aria-labelledby="secciones-titulo">
    <div class="max-w-3xl" data-reveal>
      <p class="font-display text-sm font-extrabold tracking-[0.2em] text-accent-green uppercase">Dentro de PULSO</p>
      <h2 id="secciones-titulo" class="text-display mt-4 text-4xl text-balance sm:text-5xl">
        Distintas formas de explorar la Ingeniería Biomédica.
      </h2>
      <p class="mt-5 text-lg leading-relaxed text-primary-100">
        Cada sección tiene una intención diferente: descubrir, entender, conectar y encontrar nuevas posibilidades.
      </p>
    </div>

    {/*
      Bento asimétrico (SPEC-06B). Móvil: 1 columna. Tablet: 2 columnas. Escritorio: 4 columnas
      x 4 filas, en orden de lectura 01-09:
        [01 01][02 02]
        [01 01][03][04]
        [05][06 06][07]
        [08][06 06][09]
      El reparto vive en BENTO (src/lib/secciones.ts); aquí solo se traduce a clases.
    */}
    <ul class="mt-12 grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-4" data-reveal="children">
      {
        secciones.map((seccion) => {
          const a = ACENTOS[seccion.acento];
          const Icono = ICONOS_SECCION[seccion.slug];
          const t = bento[seccion.slug];
          return (
            <li class={`group relative flex flex-col overflow-hidden rounded-2xl border border-white/10 bg-white/[0.06] transition-[transform,box-shadow,border-color] duration-300 ease-out-expo hover:-translate-y-1 hover:border-white/25 hover:shadow-shelf ${t.celda}`}>
              <span class={`absolute inset-x-0 top-0 h-1 ${a.linea}`} aria-hidden="true" />
              {t.halo && <span class={`pointer-events-none absolute inset-0 bg-radial-[at_85%_10%] to-transparent to-65% ${a.halo}`} aria-hidden="true" />}
              {t.marca && <Icono className={`pointer-events-none absolute top-[29%] -right-8 hidden h-60 w-60 stroke-[0.6] opacity-15 transition-transform duration-700 ease-out-expo group-hover:scale-105 group-hover:-rotate-3 lg:block ${a.icono}`} aria-hidden="true" />}
              <div class="relative flex items-start justify-between">
                <span class={`flex items-center justify-center rounded-full ${t.insignia} ${a.pastel} ${a.icono}`}>
                  <Icono className={t.icono} aria-hidden="true" />
                </span>
                <span class={`font-display leading-none font-bold text-white/10 select-none ${t.numero}`} aria-hidden="true">{seccion.numero}</span>
              </div>
              <div class={`relative ${t.cuerpo}`}>
                <h3 class={`font-display font-bold tracking-wide text-balance text-white ${t.titulo}`}>{seccion.nombre}</h3>
                <p class={`text-primary-100 ${t.texto}`}>{seccion.descripcion}</p>
              </div>
            </li>
          );
        })
      }
    </ul>
  </section>

  {/* ---------- Hemeroteca PULSO ---------- */}
  <section class="container-pulso py-16 sm:py-24" aria-labelledby="hemeroteca-titulo">
    <div class="flex flex-wrap items-end justify-between gap-4" data-reveal>
      <div>
        <p class="eyebrow">Todas las ediciones</p>
        <h2 id="hemeroteca-titulo" class="text-display mt-4 text-4xl sm:text-6xl">Hemeroteca PULSO</h2>
      </div>
      <a href="/ediciones" class="link-arrow group">
        Ver la hemeroteca completa
        <ArrowRight className="h-5 w-5 transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true" />
      </a>
    </div>
    <ul class="mt-12 grid grid-cols-2 gap-x-6 gap-y-12 sm:gap-x-10 md:grid-cols-3 lg:grid-cols-4" data-reveal="children">
      {enEstante.map((edicion) => <li><EdicionCard edicion={edicion} nivel="h3" /></li>)}
      {
        huecoProximamente && (
          <li class="pb-5 md:max-lg:hidden">
            <div class="flex aspect-[5/6] flex-col items-center justify-center gap-3 rounded-md border-2 border-dashed border-primary-400/60 bg-white/[0.04] p-4 text-center">
              <Clock className="h-8 w-8 text-primary-400" aria-hidden="true" />
              <p class="font-display text-lg font-bold text-white">Próximamente</p>
              <p class="text-sm text-primary-200">El siguiente número ya está en preparación.</p>
            </div>
          </li>
        )
      }
    </ul>
  </section>

  <SobreNosotros />
  <Conecta />
  <Equipo />

  {/* ---------- Contacto ---------- */}
  <section id="contacto" class="container-pulso scroll-mt-20 py-16 sm:py-24" aria-labelledby="contacto-titulo">
    <div class="max-w-3xl" data-reveal>
      <p class="eyebrow font-display text-sm font-extrabold tracking-[0.2em]">Contacto</p>
      <h2 id="contacto-titulo" class="text-display mt-4 text-4xl text-balance sm:text-5xl">Tu voz impulsa el próximo pulso</h2>
      <p class="mt-5 text-lg leading-relaxed text-primary-100">
        ¿Quieres proponer un tema, colaborar con un artículo o sumarte al equipo? Escríbenos por cualquiera de estos canales.
      </p>
    </div>
    <div class="mt-10" data-reveal>
      <ContactoBloque />
    </div>
  </section>
</Layout>

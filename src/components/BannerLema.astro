---
import { BookOpen, Users } from 'lucide-react';
import { heroCapas } from '../lib/hero-capas';

const { ancho, alto } = heroCapas.bl;
---

{/* Lema de la revista: segundo bloque del inicio, separado del Hero. */}
<section class="relative isolate overflow-hidden bg-white" aria-labelledby="lema-titulo">
  {/* Ilustración de laboratorio muy tenue y difuminada (recortes de la portada) */}
  <div class="pointer-events-none absolute inset-y-0 right-0 -z-10 w-full sm:w-[62%]" aria-hidden="true">
    <div class="absolute right-[-8%] bottom-[-12%] w-[125%] opacity-35 blur-[3px] sm:right-[-4%] sm:w-full sm:opacity-45" style={`aspect-ratio:${ancho}/${alto}`}>
      <img src="/images/hero/bl-microscopio.webp" alt="" width={ancho} height={alto} loading="lazy" decoding="async" class="absolute inset-0 h-full w-full" />
      <img src="/images/hero/bl-tubos.webp" alt="" width={ancho} height={alto} loading="lazy" decoding="async" class="absolute inset-0 h-full w-full" />
    </div>
    <div class="absolute inset-0 bg-linear-to-r from-white via-white/70 to-white/10 max-sm:via-white/85 max-sm:to-white/60"></div>
  </div>

  <div class="container-pulso py-16 sm:py-24 lg:py-28" data-reveal="children">
    <span class="block h-1.5 w-16 rounded-full bg-accent-green" aria-hidden="true"></span>
    <h2 id="lema-titulo" class="mt-6 font-display text-[2.1rem] leading-[1.02] font-extrabold tracking-[-0.02em] text-ink uppercase sm:text-5xl lg:text-[3.6rem]">
      <span class="block">Ciencia que late.</span>
      <span class="block lg:whitespace-nowrap">Conocimiento que transforma.</span>
    </h2>
    <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink/75 sm:text-xl">
      Investigación, tecnología, oportunidades y perspectivas que conectan la Ingeniería Biomédica con el futuro de la salud.
    </p>
    <div class="mt-9 flex gap-3 sm:gap-4">
      <a href="/ediciones/vol-1-num-3" class="btn btn-primary flex-1 px-3 whitespace-nowrap sm:flex-none sm:px-6">
        <BookOpen className="h-5 w-5" aria-hidden="true" />
        Leer edición 3
      </a>
      <a href="#sobre-nosotros" class="btn btn-outline flex-1 px-3 whitespace-nowrap sm:flex-none sm:px-6">
        <Users className="h-5 w-5" aria-hidden="true" />
        Sobre nosotros
      </a>
    </div>
  </div>
</section>

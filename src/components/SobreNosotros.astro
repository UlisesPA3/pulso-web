---
import { comunidadAssets as img } from '../lib/comunidad-assets';

// Textos definitivos del SPEC-05C: no se editan sin visto bueno del cliente.
const pilares = [
  {
    titulo: 'DIVULGAMOS',
    texto: 'Ciencia, investigación e innovación biomédica.',
    fondo: 'bg-primary-400/15 ring-1 ring-primary-400/30',
    color: 'text-primary-300',
  },
  {
    titulo: 'CONECTAMOS',
    texto: 'Estudiantes, academia y comunidades científicas.',
    fondo: 'bg-accent-green/10 ring-1 ring-accent-green/30',
    color: 'text-accent-green',
  },
  {
    titulo: 'IMPULSAMOS',
    texto: 'Oportunidades de formación y desarrollo profesional.',
    fondo: 'bg-accent-coral/10 ring-1 ring-accent-coral/30',
    color: 'text-accent-coral',
  },
];

const logos = [
  { ...img['logo-nexus'], alt: 'NEXUS, Tec CCM Student Chapter', clase: 'max-h-36 sm:max-h-44' },
  { ...img['logo-embs'], alt: 'IEEE EMBS, IEEE Engineering in Medicine and Biology Society: Tecnológico de Monterrey CCM Student Chapter', clase: 'max-h-24 sm:max-h-28' },
];
---

<section id="sobre-nosotros" class="band scroll-mt-20 py-16 sm:py-24" aria-labelledby="nosotros-titulo">
  <div class="container-pulso grid items-center gap-12 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:gap-16">
    <div data-reveal="children">
      <p class="font-display text-sm font-extrabold tracking-[0.2em] text-accent-coral uppercase">Sobre nosotros</p>
      <h2 id="nosotros-titulo" class="text-display mt-4 text-4xl text-balance sm:text-5xl">
        Una revista hecha por estudiantes, para conectar estudiantes.
      </h2>
      <p class="mt-6 text-lg leading-relaxed text-primary-100">
        PULSO es una revista biomédica universitaria que nace como una iniciativa de NEXUS, impulsada por estudiantes de Ingeniería Biomédica del Tecnológico de Monterrey, Campus Ciudad de México. Nuestro propósito es acercar la investigación, la ciencia y la innovación biomédica a través de contenidos claros, visuales y accesibles. Buscamos dar visibilidad a proyectos y experiencias estudiantiles, compartir oportunidades de desarrollo académico y profesional, y fortalecer los vínculos entre estudiantes y comunidades científicas a nivel local, nacional e internacional.
      </p>
      <ul class="mt-8 grid gap-3 sm:grid-cols-3">
        {
          pilares.map((p) => (
            <li class={`rounded-2xl p-5 ${p.fondo}`}>
              <h3 class={`font-display text-sm font-extrabold tracking-[0.12em] ${p.color}`}>{p.titulo}</h3>
              <p class="mt-2 text-[0.95rem] leading-snug text-primary-100">{p.texto}</p>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="surface rounded-3xl p-6 sm:p-9" data-reveal>
      <h3 class="text-center font-display text-lg font-extrabold tracking-[0.24em] text-primary-200 uppercase">Comunidad</h3>
      <ul class="mt-6 grid gap-5">
        {
          logos.map((l) => (
            <li class="flex items-center justify-center rounded-2xl bg-white px-6 py-5 shadow-[0_14px_28px_-18px_rgb(0_0_0/0.8)]">
              <img src={l.src} alt={l.alt} width={l.ancho} height={l.alto} loading="lazy" decoding="async" class={`h-auto w-auto max-w-full object-contain ${l.clase}`} />
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

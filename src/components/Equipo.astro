---
import { comunidadAssets as img } from '../lib/comunidad-assets';

const foto = img.equipo;
---

<section id="equipo" class="scroll-mt-20 py-16 sm:py-24" aria-labelledby="equipo-titulo">
  <div class="container-pulso grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
    <figure class="relative" data-reveal>
      <span class="absolute -bottom-3 -left-3 h-2/3 w-2/3 rounded-3xl bg-accent-green/50" aria-hidden="true"></span>
      <img
        src={foto.src}
        alt="Yoatzin Silva y Leonardo López, fundadores y editores de PULSO, en el campus del Tecnológico de Monterrey"
        width={foto.ancho}
        height={foto.alto}
        loading="lazy"
        decoding="async"
        class="relative aspect-[4/3] w-full rounded-3xl object-cover object-[50%_30%] shadow-lift"
      />
    </figure>

    <div data-reveal="children">
      <p class="eyebrow font-display text-sm font-extrabold tracking-[0.2em]">Conoce al equipo</p>
      <h2 id="equipo-titulo" class="text-display mt-4 text-4xl text-balance sm:text-5xl">Las personas detrás de PULSO</h2>
      <p class="mt-6 text-lg leading-relaxed text-primary-100">
        PULSO es el resultado del trabajo colaborativo de estudiantes comprometidos con la ciencia, investigación y divulgación, que buscan acercar la ingeniería biomédica a más personas y fortalecer vínculos dentro de nuestra comunidad.
      </p>
      <div class="mt-8 border-l-4 border-accent-green pl-5">
        <p class="font-display text-xl font-bold text-primary-300">Yoatzin Silva · Leonardo López</p>
        <p class="mt-1 font-semibold text-white">Área de Proyectos | Fundadores y Editores de PULSO</p>
        <p class="mt-2 text-primary-100">Responsables de la coordinación, desarrollo y dirección editorial de la revista.</p>
      </div>
    </div>
  </div>
</section>

---
import { ArrowUpRight, Mail, MapPin } from 'lucide-react';

/** Canales de contacto a la izquierda y ubicación a la derecha. Se usa en el inicio y en /contacto. */
const EMAIL = 'nexusembsccm@gmail.com';
const INSTAGRAM_URL = 'https://www.instagram.com/nexusembsccm/';
const MAPA_URL = 'https://www.google.com/maps/search/?api=1&query=Tecnol%C3%B3gico+de+Monterrey+Campus+Ciudad+de+M%C3%A9xico';
const INSTAGRAM_PATH =
  'M7.5 2h9A5.5 5.5 0 0 1 22 7.5v9a5.5 5.5 0 0 1-5.5 5.5h-9A5.5 5.5 0 0 1 2 16.5v-9A5.5 5.5 0 0 1 7.5 2Zm0 2A3.5 3.5 0 0 0 4 7.5v9A3.5 3.5 0 0 0 7.5 20h9a3.5 3.5 0 0 0 3.5-3.5v-9A3.5 3.5 0 0 0 16.5 4h-9ZM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10Zm0 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6Zm5.25-3.25a1.25 1.25 0 1 1 0 2.5 1.25 1.25 0 0 1 0-2.5Z';

const canal =
  'surface group flex h-full items-center gap-5 p-5 transition-[transform,border-color,box-shadow] duration-300 ease-out-expo hover:-translate-y-1 hover:border-primary hover:shadow-shelf sm:p-6';
const etiqueta = 'block font-mono text-xs font-medium tracking-[0.2em] uppercase';
---

<div class="grid gap-5 lg:grid-cols-2">
  <ul class="grid auto-rows-fr gap-5">
    <li>
      <a href={`mailto:${EMAIL}`} class={canal}>
        <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-primary text-white"><Mail className="h-6 w-6" aria-hidden="true" /></span>
        <span class="min-w-0">
          <span class={`${etiqueta} text-primary`}>Correo</span>
          <span class="mt-1 block font-display text-lg font-bold break-all text-ink sm:text-xl">{EMAIL}</span>
        </span>
      </a>
    </li>
    <li>
      <a href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer" class={canal}>
        <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-accent-coral text-ink">
          <svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={INSTAGRAM_PATH}></path></svg>
        </span>
        <span class="min-w-0 flex-1">
          <span class={`${etiqueta} text-accent-coral-dark`}>Instagram</span>
          <span class="mt-1 block font-display text-lg font-bold text-ink sm:text-xl">@nexusembsccm <span class="sr-only">(abre en una pestaña nueva)</span></span>
        </span>
        <ArrowUpRight className="h-5 w-5 shrink-0 text-ink/40 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-primary" aria-hidden="true" />
      </a>
    </li>
  </ul>

  <div class="surface relative flex flex-col justify-between gap-6 overflow-hidden p-6 sm:p-8">
    {/* Plano esquemático: decorativo, no es un mapa real */}
    <div class="pointer-events-none absolute inset-0 opacity-70" aria-hidden="true">
      <span class="absolute inset-0 bg-[linear-gradient(var(--color-primary-100)_1px,transparent_1px),linear-gradient(90deg,var(--color-primary-100)_1px,transparent_1px)] bg-[size:36px_36px] [mask-image:linear-gradient(105deg,transparent_35%,black)]"></span>
      <span class="absolute top-[-10%] right-[22%] h-[130%] w-3 rotate-[24deg] rounded-full bg-accent-blue/40"></span>
      <span class="absolute top-[58%] right-[-5%] h-3 w-[60%] -rotate-6 rounded-full bg-accent-green/60"></span>
    </div>
    <div class="relative">
      <span class="flex h-12 w-12 items-center justify-center rounded-full bg-accent-green text-ink"><MapPin className="h-6 w-6" aria-hidden="true" /></span>
      <p class={`${etiqueta} mt-5 text-accent-green-dark`}>Ubicación</p>
      <p class="mt-1 font-display text-xl font-bold text-ink sm:text-2xl">Tecnológico de Monterrey</p>
      <p class="mt-1 text-ink/70">Campus Ciudad de México</p>
    </div>
    <p class="relative">
      <a href={MAPA_URL} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
        <MapPin className="h-5 w-5" aria-hidden="true" />
        Abrir ubicación
        <span class="sr-only">en Google Maps (abre en una pestaña nueva)</span>
      </a>
    </p>
  </div>
</div>

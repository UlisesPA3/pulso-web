---
import { ArrowUpRight, Mail, MapPin } from 'lucide-react';

/** Canales de contacto a la izquierda y ubicación a la derecha. Se usa en el inicio y en /contacto. */
const EMAIL = 'nexusembsccm@gmail.com';
const INSTAGRAM_URL = 'https://www.instagram.com/nexusembsccm/';
const LINKEDIN_URL = 'https://linkedin.com/company/nexus-embs';
const MAPA_URL = 'https://www.google.com/maps/search/?api=1&query=Tecnol%C3%B3gico+de+Monterrey+Campus+Ciudad+de+M%C3%A9xico';
const INSTAGRAM_PATH =
  'M7.5 2h9A5.5 5.5 0 0 1 22 7.5v9a5.5 5.5 0 0 1-5.5 5.5h-9A5.5 5.5 0 0 1 2 16.5v-9A5.5 5.5 0 0 1 7.5 2Zm0 2A3.5 3.5 0 0 0 4 7.5v9A3.5 3.5 0 0 0 7.5 20h9a3.5 3.5 0 0 0 3.5-3.5v-9A3.5 3.5 0 0 0 16.5 4h-9ZM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10Zm0 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6Zm5.25-3.25a1.25 1.25 0 1 1 0 2.5 1.25 1.25 0 0 1 0-2.5Z';
// lucide-react ya no incluye logos de marcas: el de LinkedIn va como SVG en línea (glifo oficial), igual que el de Instagram.
const LINKEDIN_PATH =
  'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z';

const canal =
  'surface group flex h-full items-center gap-5 p-5 transition-[transform,border-color,box-shadow] duration-300 ease-out-expo hover:-translate-y-1 hover:border-primary-400 hover:shadow-shelf sm:p-6';
const etiqueta = 'block font-mono text-xs font-medium tracking-[0.2em] uppercase';
---

<div class="grid gap-5 lg:grid-cols-2">
  <ul class="grid auto-rows-fr gap-5">
    <li>
      <a href={`mailto:${EMAIL}`} class={canal}>
        <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-primary-500 text-white"><Mail className="h-6 w-6" aria-hidden="true" /></span>
        <span class="min-w-0">
          <span class={`${etiqueta} text-primary-300`}>Correo</span>
          <span class="mt-1 block font-display text-lg font-bold break-all text-white sm:text-xl">{EMAIL}</span>
        </span>
      </a>
    </li>
    <li>
      <a href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer" class={canal}>
        <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-accent-coral text-ink">
          <svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={INSTAGRAM_PATH}></path></svg>
        </span>
        <span class="min-w-0 flex-1">
          <span class={`${etiqueta} text-accent-coral`}>Instagram</span>
          <span class="mt-1 block font-display text-lg font-bold text-white sm:text-xl">@nexusembsccm <span class="sr-only">(abre en una pestaña nueva)</span></span>
        </span>
        <ArrowUpRight className="h-5 w-5 shrink-0 text-white/40 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-accent-green" aria-hidden="true" />
      </a>
    </li>
    <li>
      <a href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer" class={canal}>
        <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-accent-blue text-ink">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={LINKEDIN_PATH}></path></svg>
        </span>
        <span class="min-w-0 flex-1">
          <span class={`${etiqueta} text-accent-blue`}>LinkedIn</span>
          <span class="mt-1 block font-display text-lg font-bold text-white sm:text-xl">NEXUS EMBS <span class="sr-only">(abre en una pestaña nueva)</span></span>
        </span>
        <ArrowUpRight className="h-5 w-5 shrink-0 text-white/40 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-accent-green" aria-hidden="true" />
      </a>
    </li>
  </ul>

  <div class="surface relative flex flex-col justify-between gap-6 overflow-hidden p-6 sm:p-8">
    {/* Plano esquemático: decorativo, no es un mapa real */}
    <div class="pointer-events-none absolute inset-0 opacity-70" aria-hidden="true">
      <span class="absolute inset-0 bg-[linear-gradient(rgb(255_255_255/0.08)_1px,transparent_1px),linear-gradient(90deg,rgb(255_255_255/0.08)_1px,transparent_1px)] bg-[size:36px_36px] [mask-image:linear-gradient(105deg,transparent_35%,black)]"></span>
      <span class="absolute top-[-10%] right-[22%] h-[130%] w-3 rotate-[24deg] rounded-full bg-accent-blue/25"></span>
      <span class="absolute top-[58%] right-[-5%] h-3 w-[60%] -rotate-6 rounded-full bg-accent-green/30"></span>
    </div>
    <div class="relative">
      <span class="flex h-12 w-12 items-center justify-center rounded-full bg-accent-green text-ink"><MapPin className="h-6 w-6" aria-hidden="true" /></span>
      <p class={`${etiqueta} mt-5 text-accent-green`}>Ubicación</p>
      <p class="mt-1 font-display text-xl font-bold text-white sm:text-2xl">Tecnológico de Monterrey</p>
      <p class="mt-1 text-primary-100">Campus Ciudad de México</p>
    </div>
    <p class="relative">
      <a href={MAPA_URL} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
        <MapPin className="h-5 w-5" aria-hidden="true" />
        Abrir ubicación
        <span class="sr-only">en Google Maps (abre en una pestaña nueva)</span>
      </a>
    </p>
  </div>
</div>

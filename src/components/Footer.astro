---
import { ArrowUpRight, Mail } from 'lucide-react';
import LogoPulso from './React/LogoPulso';

const INSTAGRAM_URL = 'https://www.instagram.com/nexusembsccm/';
const EMAIL = 'nexusembsccm@gmail.com';
const INSTAGRAM_PATH =
  'M7.5 2h9A5.5 5.5 0 0 1 22 7.5v9a5.5 5.5 0 0 1-5.5 5.5h-9A5.5 5.5 0 0 1 2 16.5v-9A5.5 5.5 0 0 1 7.5 2Zm0 2A3.5 3.5 0 0 0 4 7.5v9A3.5 3.5 0 0 0 7.5 20h9a3.5 3.5 0 0 0 3.5-3.5v-9A3.5 3.5 0 0 0 16.5 4h-9ZM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10Zm0 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6Zm5.25-3.25a1.25 1.25 0 1 1 0 2.5 1.25 1.25 0 0 1 0-2.5Z';

const navegacion = [
  { href: '/', label: 'Inicio' },
  { href: '/#revista', label: 'Revista' },
  { href: '/#secciones', label: 'Secciones' },
  { href: '/ediciones', label: 'Ediciones' },
  { href: '/#sobre-nosotros', label: 'Sobre nosotros' },
  { href: '/contacto', label: 'Contacto' },
];

const comunidad = [
  { href: INSTAGRAM_URL, label: 'NEXUS EMBS' },
  { href: 'https://www.embs.org', label: 'IEEE EMBS' },
  { href: 'https://www.ieee.org', label: 'IEEE' },
];

const year = new Date().getFullYear();
const enlace = 'inline-flex min-h-11 items-center gap-1.5 text-primary-100 transition-colors hover:text-white';
const titulo = 'font-mono text-xs font-medium tracking-[0.22em] text-accent-green uppercase';
---

<footer class="relative mt-20 bg-black/35 text-primary-50">
  {/* Línea de ECG como borde superior */}
  <svg class="absolute inset-x-0 -top-5 h-10 w-full text-primary-400" viewBox="0 0 1200 40" fill="none" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0 20h500l14-8 14 8h22l12 14 18-32 20 34 14-16h586" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" vector-effect="non-scaling-stroke"></path>
  </svg>

  <div class="container-pulso grid gap-x-10 gap-y-12 pt-16 pb-12 sm:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr_1.3fr]">
    <div>
      <LogoPulso />
      <p class="mt-4 max-w-xs text-primary-200">
        Revista biomédica universitaria hecha por estudiantes de Ingeniería Biomédica de NEXUS EMBS.
      </p>
      <p class="mt-5 font-display text-lg text-primary-100 italic">Ciencia que late, conocimiento que transforma.</p>
    </div>

    <nav aria-labelledby="pie-navegacion">
      <h2 id="pie-navegacion" class={titulo}>Navegación</h2>
      <ul class="mt-3">
        {navegacion.map(({ href, label }) => <li><a href={href} class={enlace}>{label}</a></li>)}
      </ul>
    </nav>

    <div>
      <h2 class={titulo}>Comunidad</h2>
      <ul class="mt-3">
        {comunidad.map(({ href, label }) => (
          <li>
            <a href={href} class={`${enlace} group`} target="_blank" rel="noopener noreferrer">
              {label}
              <ArrowUpRight className="h-4 w-4 text-primary-400 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-accent-coral" aria-hidden="true" />
              <span class="sr-only">(abre en una pestaña nueva)</span>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <h2 class={titulo}>Contacto</h2>
      <ul class="mt-4 space-y-3">
        <li>
          <a href={`mailto:${EMAIL}`} class="group flex min-h-12 items-center gap-3 text-primary-100 transition-colors hover:text-white">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-white/10 transition-colors group-hover:bg-accent-green group-hover:text-ink">
              <Mail className="h-5 w-5" aria-hidden="true" />
            </span>
            <span class="text-sm break-all">{EMAIL}</span>
          </a>
        </li>
        <li>
          <a href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer" class="group flex min-h-12 items-center gap-3 text-primary-100 transition-colors hover:text-white">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-white/10 transition-colors group-hover:bg-accent-green group-hover:text-ink">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={INSTAGRAM_PATH}></path></svg>
            </span>
            <span class="text-sm">@nexusembsccm <span class="sr-only">en Instagram (abre en una pestaña nueva)</span></span>
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-white/10">
    <p class="container-pulso py-5 pb-[max(1.25rem,env(safe-area-inset-bottom))] font-mono text-xs tracking-wide text-primary-300">
      © {year} PULSO by NEXUS. Todos los derechos reservados.
    </p>
  </div>
</footer>

---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  /** La página gestiona su propio ancho (secciones a sangre, como el Hero). */
  bleed?: boolean;
}

const SITE_NAME = 'PULSO by NEXUS';
const {
  title,
  description = 'PULSO, la revista biomédica universitaria de los estudiantes de Ingeniería Biomédica de NEXUS EMBS.',
  bleed = false,
} = Astro.props;

const fullTitle = title ? `${title} | ${SITE_NAME}` : SITE_NAME;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="theme-color" content="#ffffff" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="es" />
    <meta name="twitter:card" content="summary" />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded-md focus:bg-primary focus:px-4 focus:py-2 focus:font-semibold focus:text-white"
    >
      Saltar al contenido
    </a>
    <Header />
    <main id="contenido" class:list={['flex-1', !bleed && 'container-pulso py-10 sm:py-14']}>
      <slot />
    </main>
    <Footer />
    <script>
      // Revelado al hacer scroll (Motion vanilla). El HTML llega visible: solo se oculta,
      // ya con JS, lo que está bajo el pliegue; sin JS o con movimiento reducido no pasa nada.
      import { animate, inView, stagger } from 'motion';

      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.querySelectorAll<HTMLElement>('[data-reveal]').forEach((group) => {
          if (group.getBoundingClientRect().top < window.innerHeight * 0.9) return;
          const items = group.dataset.reveal === 'children' ? [...group.children] : [group];
          items.forEach((el) => ((el as HTMLElement).style.opacity = '0'));
          inView(
            group,
            () => {
              animate(
                items,
                { opacity: [0, 1], y: [24, 0] },
                { duration: 0.6, ease: [0.16, 1, 0.3, 1], delay: stagger(0.05) },
              );
            },
            { margin: '0px 0px -12% 0px' },
          );
        });
      }
    </script>
  </body>
</html>

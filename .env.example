# ─────────────────────────────────────────────────────────────────────────────
# PULSO · Variables de entorno para conectar Astro con Sanity (SPEC-07A)
#
# EN LOCAL:  copia este archivo como `.env` en la raíz del proyecto
#            (cp .env.example .env). El .env está en .gitignore: nunca se sube.
#
# EN VERCEL: Project → Settings → Environment Variables. Agrega las tres
#            variables de abajo con el mismo nombre y valor, marcadas para
#            Production, Preview y Development, y vuelve a desplegar.
#
# Ninguna es secreta: el prefijo PUBLIC_ indica que pueden llegar al navegador.
# Si algún día se necesita un token de lectura (borradores), NO uses el
# prefijo PUBLIC_ para él.
#
# El Studio (carpeta studio/) usa sus propias variables: ver studio/.env.example
# ─────────────────────────────────────────────────────────────────────────────

# ID del proyecto en sanity.io/manage
PUBLIC_SANITY_PROJECT_ID=s78tashj

# Dataset donde viven los contenidos publicados
PUBLIC_SANITY_DATASET=production

# Fecha de versión de la API de Sanity (no cambiar sin revisar las consultas)
PUBLIC_SANITY_API_VERSION=2026-01-01
